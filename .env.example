# Copy this file to .env and fill in your key.
# Free Gemini API key: https://aistudio.google.com/apikey

GEMINI_API_KEY=your_key_here

# --- Model -------------------------------------------------------------
# GEMINI_MODEL=gemini-3.6-flash
#
# Free-tier quotas are enforced PER MODEL, PER PROJECT (a second API key in
# the same project shares the same budget). Measured on AI Studio:
#
#   family                        req/min   tokens/min   req/DAY
#   Flash      (3.5 / 3.6 / 3.7)        5         250K        20
#   Flash-Lite (3.1 / 3.5)             15         250K       500
#
# One question costs 3-6 requests, so a single Flash model is good for about
# four questions per day; a Lite model for roughly a hundred.
#
# Trade-off: only Flash models emit reasoning traces (the REASON lines in the
# ReAct output). Lite models answer just as correctly but show only ACT and
# OBSERVE. The fallback chain below is ordered to exploit this: Flash first
# for the full trace, then Lite so the demo never runs dry.
#
# NOTE: gemini-2.5-flash returns 404 for keys created recently - Google
# retired it for new projects. The agent detects this and switches model.

# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite

# --- Optional overrides ------------------------------------------------
# GEMINI_RPM=0                      # 0 = derive from model family (5 / 15)
# MAX_RETRIES=4                     # attempts per call before giving up
# MAX_AGENT_STEPS=10                # ReAct iterations before the loop gives up
# MAX_ROWS=200                      # row cap returned to the model
# QUERY_TIMEOUT_MS=5000             # abort queries slower than this
# MCP_TRANSPORT=stdio               # stdio (subprocess) or memory (in-process)
# DATABASE_PATH=data/university.db
# API_HOST=127.0.0.1
# API_PORT=8000
# CORS_ORIGINS=http://localhost:5173
